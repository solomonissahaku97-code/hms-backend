<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Subscription Successful — Tonitel HMS</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 50%, #f0f9ff 100%);
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 24px;
    }
    .card {
      background: #fff;
      border-radius: 20px;
      box-shadow: 0 20px 60px rgba(16, 185, 129, 0.12), 0 4px 16px rgba(0,0,0,0.06);
      max-width: 480px;
      width: 100%;
      overflow: hidden;
    }
    .card-header {
      background: linear-gradient(135deg, #10B981 0%, #059669 100%);
      padding: 40px 32px 48px;
      text-align: center;
      position: relative;
    }
    .card-header::after {
      content: '';
      position: absolute;
      bottom: -20px;
      left: 0;
      right: 0;
      height: 40px;
      background: #fff;
      border-radius: 20px 20px 0 0;
    }
    .success-icon {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      background: rgba(255,255,255,0.2);
      border: 3px solid rgba(255,255,255,0.5);
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 20px;
      animation: popIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    @keyframes popIn {
      0% { transform: scale(0); opacity: 0; }
      100% { transform: scale(1); opacity: 1; }
    }
    .checkmark {
      width: 40px;
      height: 40px;
    }
    .checkmark polyline {
      stroke-dasharray: 60;
      stroke-dashoffset: 60;
      animation: drawCheck 0.6s 0.3s ease forwards;
    }
    @keyframes drawCheck {
      to { stroke-dashoffset: 0; }
    }
    .card-header h1 {
      color: #fff;
      font-size: 24px;
      font-weight: 700;
      margin-bottom: 6px;
      position: relative;
      z-index: 1;
    }
    .card-header p {
      color: rgba(255,255,255,0.85);
      font-size: 14px;
      position: relative;
      z-index: 1;
    }
    .card-body {
      padding: 28px 32px 32px;
    }
    .detail-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 0;
      border-bottom: 1px solid #f1f5f9;
    }
    .detail-row:last-of-type {
      border-bottom: none;
    }
    .detail-label {
      font-size: 13px;
      color: #94a3b8;
      font-weight: 500;
    }
    .detail-value {
      font-size: 14px;
      color: #0f172a;
      font-weight: 600;
    }
    .detail-value.amount {
      color: #10B981;
      font-size: 16px;
    }
    .reference-box {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 10px;
      padding: 12px 16px;
      margin: 16px 0;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .reference-box .label {
      font-size: 11px;
      color: #94a3b8;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .reference-box .value {
      font-size: 13px;
      color: #334155;
      font-family: 'SF Mono', 'Fira Code', monospace;
      font-weight: 500;
      word-break: break-all;
    }
    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #ecfdf5;
      color: #059669;
      font-size: 12px;
      font-weight: 600;
      padding: 4px 12px;
      border-radius: 20px;
      border: 1px solid #a7f3d0;
    }
    .status-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #10B981;
      animation: pulse 2s infinite;
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.4; }
    }
    .btn-dashboard {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      width: 100%;
      padding: 14px 24px;
      background: linear-gradient(135deg, #10B981 0%, #059669 100%);
      color: #fff;
      font-size: 15px;
      font-weight: 600;
      border: none;
      border-radius: 12px;
      cursor: pointer;
      transition: all 0.2s ease;
      margin-top: 20px;
      text-decoration: none;
    }
    .btn-dashboard:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(16, 185, 129, 0.35);
    }
    .btn-dashboard:active {
      transform: translateY(0);
    }
    .footer-text {
      text-align: center;
      margin-top: 16px;
      font-size: 12px;
      color: #94a3b8;
    }
    .footer-text a {
      color: #10B981;
      text-decoration: none;
      font-weight: 500;
    }
  </style>
</head>
<body>
  <div class="card">
    <div class="card-header">
      <div class="success-icon">
        <svg class="checkmark" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 12 10 16 18 8"></polyline>
        </svg>
      </div>
      <h1>Payment Successful!</h1>
      <p>Your subscription has been activated</p>
    </div>

    <div class="card-body">
      <div style="text-align: center; margin-bottom: 20px;">
        <span class="status-badge">
          <span class="status-dot"></span>
          Subscription Active
        </span>
      </div>

      <div class="detail-row">
        <span class="detail-label">Plan</span>
        <span class="detail-value"><%= planName || 'Subscription Plan' %></span>
      </div>
      <div class="detail-row">
        <span class="detail-label">Amount Paid</span>
        <span class="detail-value amount">GH₵ <%= amount || '0.00' %></span>
      </div>
      <div class="detail-row">
        <span class="detail-label">Duration</span>
        <span class="detail-value"><%= duration || 'N/A' %> days</span>
      </div>
      <div class="detail-row">
        <span class="detail-label">Expires</span>
        <span class="detail-value"><%= expiryDate || 'N/A' %></span>
      </div>

      <div class="reference-box">
        <div>
          <div class="label">Transaction Reference</div>
          <div class="value"><%= reference || 'N/A' %></div>
        </div>
      </div>

      <a href="<%= dashboardUrl %>" class="btn-dashboard">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="7" height="7"></rect>
          <rect x="14" y="3" width="7" height="7"></rect>
          <rect x="14" y="14" width="7" height="7"></rect>
          <rect x="3" y="14" width="7" height="7"></rect>
        </svg>
        Go to Admin Dashboard
      </a>

      <p class="footer-text">
        Thank you for choosing <a href="#">Tonitel HMS</a>
      </p>
    </div>
  </div>
</body>
</html>