<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Payment Failed — Tonitel HMS</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      background: linear-gradient(135deg, #fef2f2 0%, #fff1f2 50%, #fef9ee 100%);
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 24px;
    }
    .card {
      background: #fff;
      border-radius: 20px;
      box-shadow: 0 20px 60px rgba(220, 38, 38, 0.08), 0 4px 16px rgba(0,0,0,0.06);
      max-width: 480px;
      width: 100%;
      overflow: hidden;
    }
    .card-header {
      background: linear-gradient(135deg, #EF4444 0%, #DC2626 100%);
      padding: 40px 32px 48px;
      text-align: center;
      position: relative;
    }
    .card-header::after {
      content: '';
      position: absolute;
      bottom: -20px;
      left: 0;
      right: 0;
      height: 40px;
      background: #fff;
      border-radius: 20px 20px 0 0;
    }
    .error-icon {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      background: rgba(255,255,255,0.2);
      border: 3px solid rgba(255,255,255,0.5);
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 20px;
      animation: popIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    @keyframes popIn {
      0% { transform: scale(0); opacity: 0; }
      100% { transform: scale(1); opacity: 1; }
    }
    .card-header h1 {
      color: #fff;
      font-size: 24px;
      font-weight: 700;
      margin-bottom: 6px;
      position: relative;
      z-index: 1;
    }
    .card-header p {
      color: rgba(255,255,255,0.85);
      font-size: 14px;
      position: relative;
      z-index: 1;
    }
    .card-body {
      padding: 28px 32px 32px;
    }
    .error-box {
      background: #fef2f2;
      border: 1px solid #fecaca;
      border-radius: 12px;
      padding: 16px;
      margin-bottom: 20px;
    }
    .error-box p {
      font-size: 13px;
      color: #991b1b;
      line-height: 1.5;
    }
    .error-box .error-title {
      font-weight: 600;
      margin-bottom: 4px;
    }
    .reference-box {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 10px;
      padding: 12px 16px;
      margin-bottom: 16px;
    }
    .reference-box .label {
      font-size: 11px;
      color: #94a3b8;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 4px;
    }
    .reference-box .value {
      font-size: 13px;
      color: #334155;
      font-family: 'SF Mono', 'Fira Code', monospace;
      font-weight: 500;
      word-break: break-all;
    }
    .info-list {
      list-style: none;
      margin-bottom: 20px;
    }
    .info-list li {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      padding: 8px 0;
      font-size: 13px;
      color: #64748b;
      line-height: 1.5;
    }
    .info-list li svg {
      flex-shrink: 0;
      margin-top: 2px;
    }
    .btn-retry {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      width: 100%;
      padding: 14px 24px;
      background: linear-gradient(135deg, #10B981 0%, #059669 100%);
      color: #fff;
      font-size: 15px;
      font-weight: 600;
      border: none;
      border-radius: 12px;
      cursor: pointer;
      transition: all 0.2s ease;
      text-decoration: none;
    }
    .btn-retry:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(16, 185, 129, 0.35);
    }
    .btn-dashboard {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      width: 100%;
      padding: 14px 24px;
      background: #fff;
      color: #475569;
      font-size: 15px;
      font-weight: 500;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      cursor: pointer;
      transition: all 0.2s ease;
      text-decoration: none;
      margin-top: 10px;
    }
    .btn-dashboard:hover {
      border-color: #10B981;
      color: #10B981;
    }
    .footer-text {
      text-align: center;
      margin-top: 16px;
      font-size: 12px;
      color: #94a3b8;
    }
  </style>
</head>
<body>
  <div class="card">
    <div class="card-header">
      <div class="error-icon">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="15" y1="9" x2="9" y2="15"></line>
          <line x1="9" y1="9" x2="15" y2="15"></line>
        </svg>
      </div>
      <h1>Payment Failed</h1>
      <p>Something went wrong with your subscription payment</p>
    </div>

    <div class="card-body">
      <div class="error-box">
        <p class="error-title">⚠️ Payment Not Completed</p>
        <p><%= errorMessage || 'The payment could not be processed. This may happen if the transaction was cancelled, timed out, or declined by your bank.' %></p>
      </div>

      <% if (reference) { %>
      <div class="reference-box">
        <div class="label">Transaction Reference</div>
        <div class="value"><%= reference %></div>
      </div>
      <% } %>

      <ul class="info-list">
        <li>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
          No money was deducted from your account
        </li>
        <li>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
          You can try the payment again anytime
        </li>
        <li>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
          If money was deducted, it will be reversed within 24 hours
        </li>
      </ul>

      <a href="<%= retryUrl || subscriptionUrl %>" class="btn-retry">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="23 4 23 10 17 10"></polyline>
          <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
        </svg>
        Try Again
      </a>

      <a href="<%= dashboardUrl %>" class="btn-dashboard">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="7" height="7"></rect>
          <rect x="14" y="3" width="7" height="7"></rect>
          <rect x="14" y="14" width="7" height="7"></rect>
          <rect x="3" y="14" width="7" height="7"></rect>
        </svg>
        Go to Admin Dashboard
      </a>

      <p class="footer-text">
        Need help? Contact <a href="mailto:support@tonitel.com" style="color:#10B981;text-decoration:none;font-weight:500;">support@tonitel.com</a>
      </p>
    </div>
  </div>
</body>
</html>