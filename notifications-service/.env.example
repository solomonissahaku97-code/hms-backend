# =============================================================================
# HMS Notifications Service — Environment Variables
# Copy to .env and fill in your values. NEVER commit .env to version control.
# =============================================================================

# ── App ──────────────────────────────────────────────────────────────────
DEBUG=false
PORT=8000

# ── Database (shared with HMS backend) ───────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres123@db:5432/hms
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres123@db:5432/hms

# ── Redis ────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/1
REDIS_QUEUE_DB=2

# ── Service-to-Service Auth (shared secret with HMS backend) ────────────
SERVICE_AUTH_SECRET=change-me-in-production-use-a-long-random-string

# ── JWT (for user-facing requests) ──────────────────────────────────────
JWT_SECRET=

# ── SMS Provider ─────────────────────────────────────────────────────────
# Options: twilio, termii, custom
SMS_PROVIDER=twilio
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=HMS

# ── Email Provider ───────────────────────────────────────────────────────
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=notifications@hms.com
EMAIL_USE_TLS=true

# ── Push Notifications ───────────────────────────────────────────────────
PUSH_ENGAGE_APP_ID=
PUSH_ENGAGE_API_KEY=

# ── Retry ────────────────────────────────────────────────────────────────
MAX_RETRIES=3
RETRY_BACKOFF_BASE=30
