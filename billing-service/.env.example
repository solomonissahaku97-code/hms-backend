# Billing Service Configuration
NODE_ENV=development
PORT=8000
HOST=0.0.0.0
DEBUG=true

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hms

# JWT Configuration
JWT_SECRET=your-billing-service-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN=24h

# HMS Backend (for inter-service communication)
HMS_BACKEND_URL=http://localhost:3000
HMS_BACKEND_API_KEY=your-internal-api-key

# Pharmacy Service
PHARMACY_SERVICE_URL=http://localhost:3001

# Logging
LOG_LEVEL=INFO
