# HMS Lab Service — Environment Variables
# Copy to .env and fill in your values. NEVER commit .env to version control.

# ── App ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5012

# ── Database (shared with HMS backend) ───────────────────────────────────
DB_HOST=db
DB_PORT=5432
DB_NAME=hms
DB_USER=postgres
DB_PASSWORD=postgres123
DB_DIALECT=postgres

# ── Redis ────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Service-to-Service Auth (shared secret with HMS backend) ────────────
SERVICE_AUTH_SECRET=change-me-in-production

# ── JWT ──────────────────────────────────────────────────────────────────
JWT_SECRET=

# ── Frontend URL (for PDF generation and share links) ────────────────────
FRONTEND_URL=http://localhost:5173

# ── Notifications Service (for sending lab result notifications) ────────
NOTIFICATIONS_SERVICE_URL=http://notifications-service:8000
NOTIFICATIONS_SERVICE_SECRET=change-me-in-production
