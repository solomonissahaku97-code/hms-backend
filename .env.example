# ═══════════════════════════════════════════════════════════════════════════════
# Tonitel HMS — Environment Variables
# Copy this file to .env and fill in values. NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Node ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5008

# ─── Database ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hms
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_DIALECT=postgres

# ─── JWT / Auth ──────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here
JWT_SECRET_REFRESH_TOKEN=your_refresh_token_secret_here

# ─── Encryption ──────────────────────────────────────────────────────────────
ENCRYPTION_KEY=your_encryption_key_here

# ─── Frontend URL ────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Payment ─────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=your_paystack_key_here

# ─── External APIs ───────────────────────────────────────────────────────────
RAPIDAPI_KEY=your_rapidapi_key_here

# ─── Push Notifications ─────────────────────────────────────────────────────
PUSH_ENGAGE_APP_ID=your_push_engage_app_id
PUSH_ENGAGE_API_KEY=your_push_engage_api_key
PUSH_ENGAGE_API_SECRET=your_push_engage_api_secret

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ═══════════════════════════════════════════════════════════════════════════════
# SUPABASE STORAGE (Required)
# ═══════════════════════════════════════════════════════════════════════════════
# The backend uses the SERVICE_ROLE_KEY for server-side file operations.
# NEVER expose this key through VITE_* or any public variable.
# NEVER hard-code this in source code or commit it to Git.

SUPABASE_URL=https://dtgnzjkdgazrycvwzpiu.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=hms-storage

# ═══════════════════════════════════════════════════════════════════════════════
# LEGACY STORAGE (optional — for backward compatibility with pre-Supabase files)
# ═══════════════════════════════════════════════════════════════════════════════
BACKUP_STORAGE_HOST=
BACKUP_STORAGE_PORT=22
BACKUP_STORAGE_USER=
BACKUP_STORAGE_PASS=
PUBLIC_STORAGE_URL=
