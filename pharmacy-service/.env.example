# Pharmacy Service Configuration
NODE_ENV=development
PORT=3001

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hms_pharmacy
DB_USER=postgres
DB_PASSWORD=postgres
DB_DIALECT=postgres

# JWT Configuration (for inter-service auth)
JWT_SECRET=your-pharmacy-service-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# Redis (for caching and rate limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# HMS Backend (for inter-service communication)
HMS_BACKEND_URL=http://localhost:3000
HMS_BACKEND_API_KEY=your-internal-api-key

# Logging
LOG_LEVEL=info
